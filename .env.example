# API base URLs
# Both have sane defaults in code — override only if you proxy or self-host.

# Jolpica (Ergast-compatible) — season, schedule, standings, results, historical data
VITE_JOLPICA_BASE_URL=https://api.jolpi.ca/ergast/f1

# OpenF1 — live timing, sessions, team radio, weather, race control
VITE_OPENF1_BASE_URL=https://api.openf1.org/v1
